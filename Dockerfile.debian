FROM debian:12@sha256:813017f3d62be4b5891a7acca6a01bdcd4b8513daa81b1ab99d3a50385b26931

ENV DEBIAN_FRONTEND='noninteractive'

RUN apt-get -qq update && \
	apt-get -qq -y upgrade && \
	apt-get -qq -y install \
	cmake \
	ninja-build \
	qtbase5-dev \
	libqt5svg5-dev \
	qtmultimedia5-dev \
	libgstreamer1.0-dev \
	libtagc0-dev \
	libspdlog-dev \
	libgstreamer-plugins-base1.0-dev \
	&& \
	rm -rf /var/lib/apt/lists/* /var/cache/apt/*

RUN useradd --create-home --shell /usr/sbin/nologin build
USER build

COPY --chown=build:build ./ /openkj/
WORKDIR /openkj/
# An explicit build type matters for more than optimisation: _FORTIFY_SOURCE is
# a no-op without one, so the hardening flags in CMakeLists.txt would silently
# do nothing here.
RUN cmake -DCMAKE_BUILD_TYPE=RelWithDebInfo -DSPDLOG_USE_BUNDLED=true . -B build -G Ninja
RUN ninja -C build
